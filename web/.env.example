# Copy to .env.local (gitignored). Every NEXT_PUBLIC_ variable is BUILT INTO the browser bundle:
# never put a secret in one.

# The FabPilot API. 127.0.0.1, not localhost (Windows resolves localhost to IPv6 first; uvicorn
# listens on IPv4). Open the dashboard itself as http://localhost:3000: that is the origin the
# API's CORS_ORIGINS allows.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
