# Copy to .env and fill in real values:  cp .env.example .env
# .env is gitignored. Never put real secrets in THIS file, and never paste them into a chat.
# Every variable below is read by the code (api/app/config.py) or by docker-compose.yml.

# --- Postgres (TimescaleDB + pgvector), used by docker-compose.yml ---
POSTGRES_USER=fabpilot
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fabpilot
# 127.0.0.1, not localhost: on Windows "localhost" resolves to IPv6 ::1 first, Docker only
# publishes on 127.0.0.1, and async psycopg hangs on the refused ::1 attempt (LEARNING_LOG 1.1).
POSTGRES_HOST=127.0.0.1
# Host port. 5433 (not 5432) so we don't clash with a natively installed Postgres.
POSTGRES_PORT=5433

# --- docker compose: the full backend (10.2) ---
# Host port of the API container (127.0.0.1 only). Same default as `uv run uvicorn`: run one or
# the other. In compose, POSTGRES_PASSWORD becomes part of a URL: avoid @ / : # in it.
API_PORT=8000
# Images: built from source by default. To use the prebuilt ones from GHCR instead (amd64 +
# arm64, built by CI from main), set all three:
#   IMAGE_REGISTRY=ghcr.io/gmmustafa/   (trailing slash)
#   IMAGE_TAG=latest                    (or sha-<commit> for exactly one version)
#   PULL_POLICY=always
IMAGE_REGISTRY=
IMAGE_TAG=dev
PULL_POLICY=build

# --- App -> database ---
# Async SQLAlchemy URL, psycopg 3 driver. User, password and port must match the values above.
DATABASE_URL=postgresql+psycopg://fabpilot:change-me@127.0.0.1:5433/fabpilot
# Seconds to wait for a DB connection before failing (an unreachable host must not hang).
DB_CONNECT_TIMEOUT=3
LOG_LEVEL=INFO
# Browser origins allowed to call the API: the dashboard. Comma-separated, no spaces; never "*".
CORS_ORIGINS=http://localhost:3000

# --- LLM gateway: OpenRouter and/or Groq (both free, both OpenAI-compatible) ---
# Set the key of every provider your LLM_FALLBACKS names; a route to a provider without a key
# fails at startup.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Groq: free key at console.groq.com. Limits are PER MODEL (your console's limits page is the
# source of truth), e.g. openai/gpt-oss-120b 30 RPM, 1K req/day, 8K tokens/min.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
# The fallback list, tried in order: provider:model[@reasoning-effort], comma-separated.
# - Different providers: one provider's outage or daily quota doesn't take everything down.
# - @effort per route, because models disagree: Groq gpt-oss takes low|medium|high, Groq Qwen
#   takes none; a value a model rejects is an error. No @effort = the provider's default
#   (OpenRouter: LLM_REASONING_EFFORT below; Groq: the model's own default).
# - Two Groq models are worth listing: Groq's daily limits are per model, so when one is used up
#   the next Groq model still answers. OpenRouter's free daily limit is account-wide.
# - Free OpenRouter models: openrouter.ai/models (Free + Tools); they rotate.
LLM_FALLBACKS=groq:openai/gpt-oss-120b@low,groq:qwen/qwen3.8-27b@none,openrouter:provider/model-a:free
# Older form (OpenRouter only, no prefix), used when LLM_FALLBACKS is empty:
OPENROUTER_MODELS=
# The eval judge's routes (8.4), same format. Pick a DIFFERENT model family than the agent's:
# a judge prefers answers in its own style. Empty = reuse LLM_FALLBACKS (the eval report then
# warns about self-preference). After changing it, re-run: agent_evals.judge --calibrate
JUDGE_MODELS=openrouter:provider/model-d:free,openrouter:provider/model-e:free
LLM_CONNECT_TIMEOUT=10
LLM_TIMEOUT_SECONDS=60
# Same-model retries for transient errors (5xx, a 429 without Retry-After). 1, not 2: measured in
# 5.2b, two retries on an overloaded free model used up the attempt budget before the third model
# was ever tried. With three models, moving on beats waiting.
LLM_MAX_RETRIES=1
# Hard cap of requests per gateway call, across all models (each counts against the daily quota).
LLM_MAX_ATTEMPTS=4
# OpenRouter routes without @effort use this. "none" turns thinking off on models where it's
# switchable: measured in 5.2b, free reasoning models spent 1500-4000 tokens thinking on the long
# agent prompts and never answered. Models whose reasoning is MANDATORY reject "none": don't list
# them in your OpenRouter routes (check: GET https://openrouter.ai/api/v1/models, reasoning.mandatory).
# Leave empty to use each model's default.
LLM_REASONING_EFFORT=none
LLM_DEADLINE_SECONDS=120
# Cache identical prompts in Postgres: a repeated question costs no request.
LLM_CACHE_ENABLED=true
# Cached answers expire after this many hours (one week).
LLM_CACHE_TTL_HOURS=168
# Free-tier requests per day, for the dashboard's quota bar (~50 free, ~1000 after a credit
# purchase). A guide only: requests made outside FabPilot are not counted.
LLM_DAILY_REQUEST_LIMIT=50

# --- Incident agent: run budget per question ---
# Provider requests (each gateway call may need up to LLM_MAX_ATTEMPTS of them) and tokens one
# question may use. A normal run measured 2 requests / ~5,700 tokens; these stop a runaway.
AGENT_MAX_LLM_ATTEMPTS=12
AGENT_MAX_TOKENS=40000
# Investigations at once per API process; more get HTTP 429 with Retry-After (free tier ~20 req/min).
AGENT_MAX_CONCURRENT_RUNS=2

# --- Knowledge base: local embeddings (fastembed / ONNX, no API) ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Where the model is downloaded on first use (~65 MB, measured in 10.1). Default:
# ~/.cache/fastembed. Ignored in Docker: the image has the model baked in (/opt/fastembed).
# EMBEDDING_CACHE_DIR=
# Chunk budget in model tokens (the model's hard limit is 512). Changing it re-chunks everything.
CHUNK_MAX_TOKENS=350
# The embedding DIMENSION is not configurable: it is part of the schema (vector(384), migration
# 0007). A model with another dimension needs a migration.
