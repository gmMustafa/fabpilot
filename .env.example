# Copy to .env and fill in real values:  cp .env.example .env
# .env is gitignored. Never put real secrets in THIS file, and never paste them into a chat.
# Every variable below is read by the code (api/app/config.py) or by docker-compose.yml.

# --- Postgres (TimescaleDB + pgvector), used by docker-compose.yml ---
POSTGRES_USER=fabpilot
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fabpilot
# 127.0.0.1, not localhost: on Windows "localhost" resolves to IPv6 ::1 first, Docker only
# publishes on 127.0.0.1, and async psycopg hangs on the refused ::1 attempt (LEARNING_LOG 1.1).
POSTGRES_HOST=127.0.0.1
# Host port. 5433 (not 5432) so we don't clash with a natively installed Postgres.
POSTGRES_PORT=5433

# --- App -> database ---
# Async SQLAlchemy URL, psycopg 3 driver. User, password and port must match the values above.
DATABASE_URL=postgresql+psycopg://fabpilot:change-me@127.0.0.1:5433/fabpilot
# Seconds to wait for a DB connection before failing (an unreachable host must not hang).
DB_CONNECT_TIMEOUT=3
LOG_LEVEL=INFO

# --- LLM gateway (OpenRouter, free models only) ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Fallback list, tried in order. Free models only (":free" suffix), with tool calling.
# Different providers, so one provider's outage doesn't take down every fallback.
# Current free models: openrouter.ai/models (filter: Free + Tools). Comma-separated, no spaces.
# Reasoning support per model (no quota used): GET https://openrouter.ai/api/v1/models
OPENROUTER_MODELS=provider/model-a:free,provider/model-b:free,provider/model-c:free
LLM_CONNECT_TIMEOUT=10
LLM_TIMEOUT_SECONDS=60
# Same-model retries for transient errors (5xx, a 429 without Retry-After). 1, not 2: measured in
# 5.2b, two retries on an overloaded free model used up the attempt budget before the third model
# was ever tried. With three models, moving on beats waiting.
LLM_MAX_RETRIES=1
# Hard cap of requests per gateway call, across all models (each counts against the daily quota).
LLM_MAX_ATTEMPTS=4
# OpenRouter reasoning effort for every request. "none" turns thinking off on models where it's
# switchable: measured in 5.2b, free reasoning models spent 1500-4000 tokens thinking on the long
# agent prompts and never answered. Models whose reasoning is MANDATORY reject "none": don't list
# them in OPENROUTER_MODELS (check: GET https://openrouter.ai/api/v1/models, reasoning.mandatory).
# Leave empty to use each model's default.
LLM_REASONING_EFFORT=none
LLM_DEADLINE_SECONDS=120
# Cache identical prompts in Postgres: a repeated question costs no request.
LLM_CACHE_ENABLED=true
# Cached answers expire after this many hours (one week).
LLM_CACHE_TTL_HOURS=168

# --- Knowledge base: local embeddings (fastembed / ONNX, no API) ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Where the model is downloaded on first use (~130 MB). Default: ~/.cache/fastembed
# EMBEDDING_CACHE_DIR=
# Chunk budget in model tokens (the model's hard limit is 512). Changing it re-chunks everything.
CHUNK_MAX_TOKENS=350
# The embedding DIMENSION is not configurable: it is part of the schema (vector(384), migration
# 0007). A model with another dimension needs a migration.
