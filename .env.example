# Copy to .env and fill in real values:  cp .env.example .env
# .env is gitignored. Never put real secrets in this file.

# --- Postgres (TimescaleDB + pgvector) ---
POSTGRES_USER=fabpilot
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fabpilot
# 127.0.0.1, not localhost: on Windows "localhost" resolves to IPv6 ::1 first, Docker only
# publishes on 127.0.0.1, and async psycopg hangs on the refused ::1 attempt (see LEARNING_LOG 1.1).
POSTGRES_HOST=127.0.0.1
# Host port. 5433 (not 5432) so we don't clash with a natively installed Postgres.
POSTGRES_PORT=5433
# Async SQLAlchemy URL using the psycopg 3 driver (port must match POSTGRES_PORT)
DATABASE_URL=postgresql+psycopg://fabpilot:change-me@127.0.0.1:5433/fabpilot

# --- LLM gateway (OpenRouter, free models only) ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Fallback list, tried in order. Free models only (":free" suffix), must support tool calling.
# Pick from different providers so one provider outage doesn't take down all fallbacks.
# Check current models: openrouter.ai/models (filter: Free + Tools). No quotes.
# Format: OPENROUTER_MODELS=provider/model-a:free,provider/model-b:free,provider/model-c:free
OPENROUTER_MODELS=
LLM_CONNECT_TIMEOUT=10
LLM_TIMEOUT_SECONDS=60
# Same-model retries for transient errors, and the hard cap of requests per call (all models).
LLM_MAX_RETRIES=2
LLM_MAX_ATTEMPTS=4
LLM_DEADLINE_SECONDS=120
# Cache identical prompts in Postgres (saves free-tier quota during development)
LLM_CACHE_ENABLED=true
# Cached answers expire after this many hours (default: one week).
LLM_CACHE_TTL_HOURS=168

# --- Optional local LLM (Ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

# --- Embeddings (local, sentence-transformers) ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# --- App ---
LOG_LEVEL=INFO
