# Copy to .env and fill in real values:  cp .env.example .env
# .env is gitignored. Never put real secrets in this file.

# --- Postgres (TimescaleDB + pgvector) ---
POSTGRES_USER=fabpilot
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fabpilot
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Async SQLAlchemy URL using the psycopg 3 driver
DATABASE_URL=postgresql+psycopg://fabpilot:change-me@localhost:5432/fabpilot

# --- LLM gateway (OpenRouter, free models only) ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Fallback list, tried in order. Free models only (":free" suffix), must support tool calling.
# Pick from different providers so one provider outage doesn't take down all fallbacks.
# Check current models: openrouter.ai/models (filter: Free + Tools). No quotes.
# Format: OPENROUTER_MODELS=provider/model-a:free,provider/model-b:free,provider/model-c:free
OPENROUTER_MODELS=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3
# Cache identical prompts in Postgres (saves free-tier quota during development)
LLM_CACHE_ENABLED=true

# --- Optional local LLM (Ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

# --- Embeddings (local, sentence-transformers) ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# --- App ---
LOG_LEVEL=INFO
